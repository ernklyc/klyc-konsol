<UserControl x:Class="KlycKonsol.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="Row">
            <Grid>
                <!-- Bölüm başlığı -->
                <TextBlock Text="{Binding Title}" Visibility="{Binding HeaderVisibility}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextDim}" Margin="14,26,0,10"/>

                <!-- Satır -->
                <Border x:Name="Box" Visibility="{Binding RowVisibility}" Height="100" Margin="0,5" CornerRadius="26"
                        Background="{StaticResource Card}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1.5" Padding="30,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="40"
                                   VerticalAlignment="Center" Margin="0,0,28,0" Width="50"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Cap" Text="{Binding Caption}" FontSize="20" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Visibility="{Binding BarVisibility}" Width="260" Height="12" Margin="0,0,22,0" VerticalAlignment="Center">
                                <Border CornerRadius="6" Background="#33FFFFFF"/>
                                <Border x:Name="Fill" CornerRadius="6" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                            </Grid>
                            <TextBlock x:Name="Val" Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Lit}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Cap" Property="Foreground" Value="#5A6277"/>
                    <Setter TargetName="Val" Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource Ink}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="90,0,90,0">
        <TextBlock Text="Ayarlar" FontSize="64" FontWeight="Bold" VerticalAlignment="Top"/>
        <Canvas x:Name="Port" Margin="0,100,0,0" ClipToBounds="True" HorizontalAlignment="Left" Width="1300">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource Row}" Width="1300" Canvas.Left="0" Canvas.Top="0">
                <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
            </ItemsControl>
        </Canvas>
    </Grid>
</UserControl>
