<Window x:Class="KlycKonsol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KlycKonsol.Ui"
        Title="KLYC Konsol" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#0B0D11" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Grid>
        <ui:BackdropView x:Name="Backdrop"/>

        <Viewbox x:Name="Chrome" Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>

                <ui:NavBar x:Name="Nav" Grid.Row="0"/>
                <Grid x:Name="PageHost" Grid.Row="1"/>

                <!-- Alt ipucu çubuğu -->
                <StackPanel x:Name="Hints" Grid.Row="2" Orientation="Horizontal" Margin="90,0,0,14" VerticalAlignment="Center"/>

                <!-- Bildirim -->
                <Border x:Name="ToastBox" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,90,14" Opacity="0"
                        Style="{StaticResource Glass}" CornerRadius="30" Padding="30,14" Background="#33FFFFFF">
                    <TextBlock x:Name="ToastText" FontSize="24" FontWeight="SemiBold"/>
                </Border>

                <!-- Başlatılıyor / onay -->
                <Grid x:Name="Overlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#E80B0D11">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border x:Name="OverlayCover" Width="250" Height="334" CornerRadius="26" Margin="0,0,0,34" HorizontalAlignment="Center"
                                BorderBrush="White" BorderThickness="4"/>
                        <TextBlock x:Name="OverlayTitle" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1300"/>
                        <TextBlock x:Name="OverlayBody" FontSize="28" Visibility="Collapsed" Foreground="{StaticResource Text}" Margin="0,22,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1300" LineHeight="40"/>
                        <TextBlock x:Name="OverlayHint" FontSize="30" Foreground="{StaticResource TextDim}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- WebView2 gibi HWND'li öğeler Viewbox içinde ölçeklenemez; bu katmanda dururlar -->
        <Grid x:Name="WebLayer"/>
    </Grid>
</Window>
