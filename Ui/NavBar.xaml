<UserControl x:Class="KlycKonsol.Ui.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="112">
        <StackPanel VerticalAlignment="Center" Margin="90,0,0,0">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="KLYC" FontSize="38" FontWeight="Black"/>
            <TextBlock Text=" KONSOL" FontSize="38" FontWeight="Black" Foreground="{StaticResource Accent}"/>
        </StackPanel>
        <StackPanel x:Name="PulseChip" Orientation="Horizontal" Margin="2,2,0,0" Visibility="Collapsed">
            <TextBlock x:Name="PulseGlyph" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="PulseText" FontSize="17" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
        </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="BadgeLB" Background="#33FFFFFF" CornerRadius="12" Height="38" MinWidth="58" Margin="0,0,14,0" Cursor="Hand">
                <TextBlock Text="LB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Pill" Style="{StaticResource Glass}" CornerRadius="44" Padding="8" Background="#22FFFFFF">
                <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
            </Border>
            <Border x:Name="BadgeRB" Background="#33FFFFFF" CornerRadius="12" Height="38" MinWidth="58" Margin="14,0,0,0" Cursor="Hand">
                <TextBlock Text="RB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,90,0">
            <TextBlock x:Name="PadGlyph" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="30"
                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="PadText" Text="Aranıyor" FontSize="22" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" Margin="0,0,34,0"/>
            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,34,0" Visibility="Collapsed">
                <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"/>
                <TextBlock x:Name="BatteryText" FontSize="22" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Clock" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateText" FontSize="18" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                <Border x:Name="BtnHide" Width="52" Height="52" CornerRadius="26" Background="#22FFFFFF" Margin="0,0,10,0" Cursor="Hand" ToolTip="Arka plana indir (oyun modu) — Ctrl+Alt+K">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BtnExit" Width="52" Height="52" CornerRadius="26" Background="#22FFFFFF" Cursor="Hand" ToolTip="Konsol'dan çık">
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
